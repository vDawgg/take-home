POSTGRES_USER=postgres
POSTGRES_PASSWORD=pass
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:pass@localhost:5432/postgres
# Uvicorn processes. Total DB connections = UVICORN_WORKERS * DB_POOL_MAX_SIZE,
# which must stay below Postgres max_connections (100).
UVICORN_WORKERS=1
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
